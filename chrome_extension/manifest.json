
{
  "manifest_version": 3,
  "name": "Soul Widgets Manager",
  "version": "0.2",
  "description": "Place your shortcuts and widgets on the desktop",
  "author": "supechicken666@gmail.com",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["offscreen", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://*.bandcamp.com/*",
    "https://music.apple.com/*",
    "https://www.deezer.com/*",
    "https://tidal.com/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://*.bandcamp.com/*",
        "https://music.apple.com/*",
        "https://www.deezer.com/*",
        "https://tidal.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/soul-16.png",
    "32": "assets/soul-32.png",
    "48": "assets/soul-48.png",
    "128": "assets/soul-128.png"
  }
}